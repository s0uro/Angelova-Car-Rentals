// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reservation {
  id              String    @id @default(cuid())
  type            String // "car" | "taxi"
  carName         String?
  name            String
  surname         String    @default("")
  age             Int       @default(25)
  phone           String
  email           String?
  pickupDate      DateTime  @db.Timestamptz(6)
  dropoffDate     DateTime? @db.Timestamptz(6)
  pickupLocation  String
  dropoffLocation String?
  passengers      Int? // taxi bookings only
  notes           String?
  agreedToTerms   Boolean   @default(false)
  status          String    @default("new") // see app/lib/reservation-status.ts: new | confirmed | rejected | expired
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([carName, status, pickupDate])
}

model AdminUser {
  id           String @id @default(cuid())
  name         String @unique
  passwordHash String
}
