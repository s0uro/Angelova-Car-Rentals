# Supabase Postgres. Runtime should use the *transaction pooler* URL
# (port 6543) and migrations the direct URL (port 5432).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Signs the admin session cookie. Must be >= 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-string"

# Used only by `npm run db:seed` to create/update the admin login.
ADMIN_NAME="admin"
ADMIN_PASSWORD="change-this-password"

# Optional: shared rate limiting for the booking form and admin login
# (https://upstash.com, free tier). Without these a per-instance in-memory
# limiter is used, which is fine for local dev.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
