DATABASE_URL="file:./dev.db"

# Used to sign the admin session cookie. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-string"

# Used only by `npm run db:seed` to create/update the admin login.
ADMIN_NAME="admin"
ADMIN_PASSWORD="change-this-password"
